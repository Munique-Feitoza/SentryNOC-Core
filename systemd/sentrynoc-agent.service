[Unit]
Description=SentryNOC Core lightweight telemetry agent
After=network.target

[Service]
Type=simple
ExecStart=/opt/sentrynoc/sentrynoc-agent --interval-ms 1000 --spool /var/lib/sentrynoc/telemetry.ndjson
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sentrynoc

[Install]
WantedBy=multi-user.target
