[Unit]
Description=SentryNOC Core telemetry collector
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/sentrynoc
Environment=SENTRYNOC_HOST=127.0.0.1
Environment=SENTRYNOC_PORT=8787
Environment=SENTRYNOC_DB=/var/lib/sentrynoc/sentrynoc.db
ExecStart=/usr/bin/python3 /opt/sentrynoc/collector/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sentrynoc

[Install]
WantedBy=multi-user.target
